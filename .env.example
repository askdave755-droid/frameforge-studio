# Server
PORT=8787
PUBLIC_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173,https://askdave755-droid.github.io

# Video generation via Runware
RUNWARE_API_KEY=
RUNWARE_MODEL=minimax:h3@max-turbo
RUNWARE_RESOLUTION=480p

# Voice generation
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Any VOICE_<key>_ID variable maps the ElevenLabs voice ID to the voice card
# with the matching id in src/App.jsx (case-insensitive).
VOICE_BRADYJ_ID=
VOICE_NEWDAVE2026_ID=
VOICE_SORA_ID=
